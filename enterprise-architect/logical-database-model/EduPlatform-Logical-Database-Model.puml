@startuml EduPlatform_Logical_Database_Model
!theme plain
left to right direction
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam nodesep 55
skinparam ranksep 50
title Логическая модель реляционной базы данных EduPlatform

package "Блок 1" {
  entity "AspNetUsers" as tbl_AspNetUsers {
    * PK Id
    + Email
    + NormalizedEmail
    + UserName
    + NormalizedUserName
    + PasswordHash
    + FirstName
    + LastName
    + AvatarUrl
    + EmailConfirmed
    + PhoneNumber
    + PhoneNumberConfirmed
    + LockoutEnabled
    + LockoutEnd
    + AccessFailedCount
    + SecurityStamp
    + ConcurrencyStamp
    + TwoFactorEnabled
    + CreatedAt
    + UpdatedAt
  }

  entity "AspNetRoles" as tbl_AspNetRoles {
    * PK Id
    + Name
    + NormalizedName
    + ConcurrencyStamp
  }

  entity "AspNetUserRoles" as tbl_AspNetUserRoles {
    * PK FK UserId
    * PK FK RoleId
  }

  entity "AspNetUserClaims" as tbl_AspNetUserClaims {
    * PK Id
    + FK UserId
    + ClaimType
    + ClaimValue
  }

  entity "AspNetRoleClaims" as tbl_AspNetRoleClaims {
    * PK Id
    + FK RoleId
    + ClaimType
    + ClaimValue
  }

  entity "AspNetUserLogins" as tbl_AspNetUserLogins {
    * PK LoginProvider
    * PK ProviderKey
    + ProviderDisplayName
    + FK UserId
  }

  entity "AspNetUserTokens" as tbl_AspNetUserTokens {
    * PK FK UserId
    * PK LoginProvider
    * PK Name
    + Value
  }

  entity "RefreshTokens" as tbl_RefreshTokens {
    * PK Id
    + Token
    + FK UserId
    + ExpiresAt
    + CreatedAt
    + IsRevoked
  }

  entity "PlatformSettings" as tbl_PlatformSettings {
    * PK Id
    + RegistrationOpen
    + MaintenanceMode
    + PlatformName
    + SupportEmail
    + UpdatedAt
  }

}

package "Блок 2" {
  entity "Disciplines" as tbl_Disciplines {
    * PK Id
    + Name
    + Description
    + ImageUrl
    + CreatedAt
    + UpdatedAt
  }

  entity "Courses" as tbl_Courses {
    * PK Id
    + FK DisciplineId
    + FK TeacherId
    + TeacherName
    + Title
    + Description
    + Price
    + IsFree
    + IsPublished
    + IsArchived
    + ArchiveReason
    + ArchivedBy
    + OrderType
    + Deadline
    + ImageUrl
    + Level
    + RatingAverage
    + RatingCount
    + ReviewsCount
    + CreatedAt
    + UpdatedAt
  }

  entity "CourseTags" as tbl_CourseTags {
    * PK FK CourseId
    * PK FK TagId
  }

  entity "Tags" as tbl_Tags {
    * PK Id
    + Slug
    + Name
    + UsageCount
  }

  entity "CourseModules" as tbl_CourseModules {
    * PK Id
    + FK CourseId
    + Title
    + Description
    + OrderIndex
    + IsPublished
  }

  entity "Lessons" as tbl_Lessons {
    * PK Id
    + FK ModuleId
    + Title
    + Description
    + OrderIndex
    + IsPublished
    + Duration
    + Layout
  }

  entity "CourseItems" as tbl_CourseItems {
    * PK Id
    + FK CourseId
    + FK ModuleId
    + Type
    + FK SourceId
    + Title
    + Description
    + Url
    + FK AttachmentId
    + ResourceKind
    + OrderIndex
    + Status
    + IsRequired
    + Points
    + AvailableFrom
    + Deadline
    + CreatedAt
    + UpdatedAt
  }

  entity "CourseEnrollments" as tbl_CourseEnrollments {
    * PK Id
    + FK CourseId
    + FK StudentId
    + EnrolledAt
    + Status
  }

  entity "CourseReviews" as tbl_CourseReviews {
    * PK Id
    + FK CourseId
    + FK StudentId
    + StudentName
    + Rating
    + Comment
    + CreatedAt
    + UpdatedAt
  }

}

